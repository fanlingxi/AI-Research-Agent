# Knowledge Core requires a live LLM for extraction and report generation.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Optional upper bound forwarded to OpenAI-compatible Chat Completions calls.
# Leave blank for the provider default. Use 512 for the live smoke report.
LLM_MAX_TOKENS=
# Optional reasoning setting forwarded to OpenAI-compatible models. For
# providers that support this field, select a value accepted by the chosen model.
LLM_REASONING_EFFORT=
# Optional explicit prices used for report cost accounting, for example:
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# For an OpenAI-compatible provider, set its endpoint here and keep the key local.

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
# Optional local semantic profile (install requirements-embeddings.txt and pinned weights first):
# EMBEDDING_PROVIDER=qwen3-local
# EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=data/models/embeddings
EMBEDDING_BATCH_SIZE=2

# Existing physical names remain stable to preserve current Knowledge Base data.
KNOWLEDGE_DB_PATH=data/knowledge/knowledge.db
KNOWLEDGE_VAULT_PATH=data/obsidian_vault_v2
# PDF layout parser for new imports and re-parses. Default pypdf-v3; pypdf-v4
# (zoning rules v2) is opt-in because it did not pass the D040 holdout gates.
# PDF_PARSER_VERSION=pypdf-v4
# URL imports: decoded byte limit, total download deadline, redirect limit.
PDF_DOWNLOAD_MAX_BYTES=104857600
PDF_DOWNLOAD_TIMEOUT_SECONDS=120
PDF_DOWNLOAD_MAX_REDIRECTS=5
# Development only: permits private/loopback targets and nonstandard ports.
PDF_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false
KNOWLEDGE_QDRANT_COLLECTION=knowledge_chunks_v2
KNOWLEDGE_WORKER_LEASE_SECONDS=180
KNOWLEDGE_WORKER_POLL_SECONDS=1.0
REPORT_MIN_CITATION_COVERAGE=0.9
REPORT_MIN_RETRIEVAL_RELEVANCE=0.6
REPORT_MIN_SOURCE_DIVERSITY=3

# Project research default: standard = dense-v1 / coverage-v2 / inline-v1,
# research_v8, 16,000 context tokens and 1,048,576 run tokens (10 steps / 3 tools).
# Use classic to restore legacy retrieval and research (6,000 tokens).
# Standard automatically falls back to classic without explicit knowledge scope
# or when vector retrieval is unavailable. Quick reports are unaffected.
RESEARCH_DEFAULT_PROFILE=standard

QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=research-agent

API_PORT=8000
WEB_PORT=5173
QDRANT_PORT=6333
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
