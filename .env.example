# LLM provider: mock, openai, qwen, deepseek
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen, OpenAI-compatible DashScope endpoint
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek, OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Phase 2+
SEARCH_LIVE_ENABLED=false
PAPER_SEARCH_LIMIT=5

CHUNK_SIZE=900
CHUNK_OVERLAP=150

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

VECTOR_STORE_PROVIDER=memory
RETRIEVAL_TOP_K=5

GRAPH_STORE_PROVIDER=memory
GRAPH_ENTITIES_PER_CHUNK=8
GRAPH_MAX_HOPS=2
GRAPH_TOP_K=5

MEMORY_ENABLED=true
MEMORY_PATH=data/memory/research_memory.json
MEMORY_RECALL_LIMIT=3

EVALUATION_PASSING_SCORE=0.72
EVALUATION_CRITICAL_MIN_SCORE=0.65
CRITIC_MIN_SCORE=0.78

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
