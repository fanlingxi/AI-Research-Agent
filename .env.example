# Knowledge Core requires a live LLM for extraction and report generation.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Optional upper bound forwarded to OpenAI-compatible Chat Completions calls.
# Leave blank for the provider default. Use 512 for the live smoke report.
LLM_MAX_TOKENS=
# Optional reasoning setting forwarded to OpenAI-compatible models. For
# gpt-5.6-luna through the configured proxy, use `none` to avoid reasoning-token
# overhead during bounded acceptance checks.
LLM_REASONING_EFFORT=
# Optional explicit prices used for report cost accounting, for example:
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# To manually switch an OpenAI-compatible proxy, set the same OPENAI_BASE_URL
# to exactly one endpoint for the current process:
#   normal text traffic: https://api.sharesai.xyz/v1
#   large-file/image proxy smoke: https://bnode.sharesai.xyz/v1
# Keep OPENAI_API_KEY only in this ignored local .env file or the process environment.

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Existing physical names remain stable to preserve current Knowledge Base data.
KNOWLEDGE_DB_PATH=data/knowledge/knowledge.db
KNOWLEDGE_VAULT_PATH=data/obsidian_vault_v2
KNOWLEDGE_QDRANT_COLLECTION=knowledge_chunks_v2
KNOWLEDGE_WORKER_LEASE_SECONDS=180
KNOWLEDGE_WORKER_POLL_SECONDS=1.0
REPORT_MIN_CITATION_COVERAGE=0.9

QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=research-agent

API_PORT=8000
WEB_PORT=5173
STREAMLIT_PORT=8501
# Browser-facing operations console URL compiled into the React production build.
VITE_OPERATIONS_URL=http://127.0.0.1:8501
QDRANT_PORT=6333
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
